const topics2025 = [
  'Machine Learning and AI for EO — self-supervised, multimodal, domain-adaptive, continual/online learning, foundation models, human-in-the-loop, active learning',
  'Physics-based and Hybrid Modeling — Radiative Transfer Models, hybrid AI–physics for parameter retrieval and uncertainty quantification',
  'Ecology and Environmental Monitoring — land use/cover change, biodiversity, phenology, biomass, canopy height, soil/vegetation condition',
  'Remote Sensing and Satellite Data Processing — multispectral, SAR, LiDAR, hyperspectral; multi-resolution fusion; temporal change detection; cross-sensor harmonization',
  'Embeddings and Compression — learned representations, semantic compression for large EO archives',
  'Earth Science Applications — geophysical parameter estimation, urban/rural mapping, geohazards (floods, landslides, volcanic activity)',
  'Data Curation, Bias, and Accessibility — globally representative datasets, bias mitigation, open benchmarks',
  'Technical and Use Case Innovations — novel architectures, training strategies, pipelines',
];

const metadata = {
  title: 'REO-1 (2025) — 1st Workshop on Advances in Representation Learning for Earth Observation',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <header class="sticky top-0 z-40 border-b border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/90 backdrop-blur">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 grid grid-cols-3 items-center">
        <a href="/2025" class="font-bold text-lg tracking-tight">REO 2025</a>
        <a href="/2026" class="text-center text-sm md:text-base text-primary hover:underline font-medium">
          The 2026 edition will be held at NeurIPS in Paris!
        </a>
        <div></div>
      </div>
    </header>
  </Fragment>

  <!-- The custom sticky header is opaque, so offset the Hero's pull-up under the header -->
  <div class="md:pt-[76px]">
    <Hero
      tagline='<span class="text-blue-300 dark:text-blue-300">EurIPS 2025 · Copenhagen, Denmark · Sunday, Dec 7</span>'
      actions={[
        { variant: 'primary', text: 'Accepted Papers', href: '#papers' },
        {
          variant: 'secondary',
          text: 'Keynotes',
          href: '#speakers',
          class: '!bg-slate-200 hover:!bg-slate-300 !text-slate-900 !border-slate-200 hover:!border-slate-300 dark:!bg-slate-200 dark:hover:!bg-slate-300 dark:!text-slate-900 dark:!border-slate-200',
        },
      ]}
    >
      <Fragment slot="bg">
        <div class="absolute inset-0 overflow-hidden">
          <Image
            src={copenhagenS2}
            alt="Sentinel-2 satellite image of Copenhagen"
            width={2400}
            height={1200}
            widths={[800, 1600, 2400]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            layout="cover"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-slate-900/75 via-slate-900/60 to-slate-900/85 dark:from-slate-950/85 dark:via-slate-950/70 dark:to-slate-950/90"></div>
        </div>
        <p class="absolute bottom-2 right-3 text-[10px] text-white/70 z-10">
          Sentinel-2 image of Copenhagen – Credit: ESA, European Union
        </p>
      </Fragment>

      <Fragment slot="title">
        <span class="text-white drop-shadow-lg">1st Workshop on Advances in <span class="text-blue-300">Representation Learning for Earth Observation</span></span>
      </Fragment>

      <Fragment slot="subtitle">
        <span class="text-slate-100">
          Held on December 7, 2025 at the University of Copenhagen, as part of EurIPS 2025.
        </span>
      </Fragment>
    </Hero>
  </div>

  <!-- Stats -->
  <section class="pt-16 md:pt-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-center">
          <div class="text-4xl font-bold text-primary">117</div>
          <p class="text-sm text-muted mt-1">Registered participants</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-center">
          <div class="text-4xl font-bold text-primary">33</div>
          <p class="text-sm text-muted mt-1">Poster presentations</p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-center">
          <div class="text-4xl font-bold text-primary">5</div>
          <p class="text-sm text-muted mt-1">Oral presentations</p>
        </div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">About REO-1</p>
      <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2 mb-6">
        Uniting ML, computer vision, and Earth sciences
      </h2>
      <div class="space-y-4 text-lg text-muted">
        <p>
          The first REO workshop brought together researchers from machine learning, computer
          vision, and Earth sciences to advance robust, interpretable, and scalable models for
          monitoring our planet. It addressed opportunities arising from large-scale multimodal
          EO data and foundation models, fostering cross-disciplinary exchange between academia,
          industry, and policy.
        </p>
        <p>
          Recent developments discussed included Google DeepMind's AlphaEarth, IBM–ESA's TerraMind,
          AllenAI's Earth System, and Meta's DINOv3.
        </p>
        <div class="pl-4 border-l-4 border-primary/40 italic text-base">
          <p class="mb-2">Three guiding questions framed the workshop:</p>
          <ol class="list-decimal list-inside space-y-1 not-italic">
            <li>Where are we, and how can we move forward as a community?</li>
            <li>What are the open challenges in learning representations of EO data?</li>
            <li>In the era of general-purpose one-for-all models, what is the role of specialized approaches?</li>
          </ol>
        </div>
        <p class="text-sm">
          <strong>Venue:</strong> University of Copenhagen South Campus, Njalsgade 76,
          Auditorium 4A.0.69, ground floor, 2300 København S. Not at the main EurIPS venue;
          closest metro station: Islands Brygge.
        </p>
      </div>
    </div>
  </section>

  <!-- Call for Papers -->
  <section id="call-for-papers" class="scroll-mt-16 bg-blue-50 dark:bg-transparent">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 md:pt-20 mb-10 md:mb-12 text-center">
      <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">Call for Papers</p>
      <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Two submission tracks</h2>
    </div>

    <!-- Tracks + dates -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-6 bg-white dark:bg-slate-900">
          <h3 class="text-xl font-bold mb-2">Research Track</h3>
          <p class="text-muted">
            Novel unpublished work of up to <strong>4 pages single column</strong> (excluding
            references) using the NeurIPS template. Short supplementary material allowed.
            <strong>Double-blind</strong>, non-archival.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-6 bg-white dark:bg-slate-900">
          <h3 class="text-xl font-bold mb-2">Highlights Track</h3>
          <p class="text-muted">
            Recently published work: papers published after NeurIPS 2024 could be submitted as-is.
            <strong>Single-blind</strong> (anonymous reviewers only).
          </p>
        </div>
      </div>
      <p class="text-sm text-muted mt-4">
        Accepted contributions were presented as posters; authors could indicate interest in a
        10-minute oral talk.
      </p>

      <div class="mt-10">
        <h3 class="text-2xl font-bold mb-4">Important Dates</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-700">
                <th class="py-3 pr-4 font-semibold">Milestone</th>
                <th class="py-3 font-semibold">Date (AoE)</th>
              </tr>
            </thead>
            <tbody class="text-muted">
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-3 pr-4">Submission deadline</td><td class="py-3">Oct 15 → extended to Oct 20, 2025</td>
              </tr>
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-3 pr-4">Notification of acceptance</td><td class="py-3">Oct 31, 2025</td>
              </tr>
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-3 pr-4">Camera-ready</td><td class="py-3">Nov 28, 2025</td>
              </tr>
              <tr>
                <td class="py-3 pr-4">Workshop day</td><td class="py-3">Dec 7, 2025 — University of Copenhagen, South Campus</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-10">
        <h3 class="text-2xl font-bold mb-4">Topics of Interest</h3>
        <ul class="space-y-2 text-muted">
          {topics2025.map((t) => <li>· {t}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Invited Speakers -->
  <section id="speakers" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">Invited Speakers</p>
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Keynotes</h2>
        <p class="max-w-3xl mx-auto mt-4 text-xl text-muted">
          All keynotes were recorded. Watch them on the
          <a href="https://www.youtube.com/@advances-REO-workshop" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-primary underline">workshop YouTube channel<Icon name="tabler:arrow-up-right" class="w-5 h-5" /></a>
        </p>
      </div>

      <!-- Speakers: centered, auto-wrapping (3 / 2 / 1 per row by breakpoint) -->
      <div class="flex flex-wrap justify-center gap-6">
        {speakers2025.map((s) => (
          <div class="flex flex-col rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
            <div class="aspect-square overflow-hidden bg-slate-100 dark:bg-slate-800">
              <Image
                src={s.image}
                alt={s.name}
                width={600}
                height={600}
                layout="constrained"
                widths={[300, 600, 900]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                class="w-full h-full object-cover object-center"
              />
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold">{s.name}</h3>
              <p class="text-sm text-primary dark:text-blue-300 font-medium">{s.affiliation}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Accepted Papers (same card grid as 2026) -->
  <section id="papers" class="scroll-mt-16 py-16 md:py-20 bg-blue-50 dark:bg-transparent">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">Program</p>
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Accepted Papers</h2>
        <p class="max-w-3xl mx-auto mt-4 text-xl text-muted">
          33 papers were presented at the workshop, 5 of them as orals.
        </p>
      </div>

      <!-- First 9 shown; the checkbox reveals the rest (CSS only) -->
      <div class="group">
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {acceptedPapers.map((p, i) => {
            const poster = local(p.poster);
            const paper = local(p.paper);
            const links = [p.paper && !paper && ['Paper', p.paper], p.video && ['Video', p.video]].filter((l): l is string[] => !!l);
            // Opens the PdfViewer (md+); falls back to the PDF in a new tab
            const view = (kind: string) => ({
              href: kind === 'poster' ? poster : paper, target: '_blank', 'data-pdf': p.id, 'data-kind': kind, 'data-title': p.title,
              'data-poster': poster, 'data-paper': paper, 'data-links': JSON.stringify(links),
            });
            return (
            <li class={i >= 9 ? 'hidden group-has-[:checked]:block' : ''}>
              <!-- Title link is stretched over the card (opens the poster, else the paper); chips sit above it -->
              <div class="relative h-full rounded-md bg-white dark:bg-slate-900 p-4 border border-slate-200 dark:border-slate-700 hover:border-primary dark:hover:border-blue-300 transition-colors">
                <div class="flex flex-wrap items-center gap-1 mb-1.5 text-[10px] font-semibold uppercase tracking-wide">
                  <span class="font-mono text-xs text-primary dark:text-blue-300 mr-0.5">#{p.id}</span>
                  {p.highlight && <span class="px-1.5 py-0.5 rounded bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-200">Highlights Track</span>}
                  {poster && <a {...view('poster')} class="relative z-10 inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded transition-colors bg-blue-200 text-blue-900 hover:bg-blue-300 dark:bg-blue-800/70 dark:text-blue-100 dark:hover:bg-blue-700">Poster</a>}
                  {paper && <a {...view('paper')} class="relative z-10 inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded transition-colors bg-sky-100 text-sky-800 hover:bg-sky-200 dark:bg-sky-900/60 dark:text-sky-200 dark:hover:bg-sky-800">Paper</a>}
                  {links.map(([label, href]) => (
                    <a href={href} target="_blank" rel="noopener" class={`relative z-10 inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded transition-colors ${label === 'Video' ? 'bg-slate-200 text-slate-700 hover:bg-slate-300 dark:bg-slate-700 dark:text-slate-200 dark:hover:bg-slate-600' : 'bg-sky-100 text-sky-800 hover:bg-sky-200 dark:bg-sky-900/60 dark:text-sky-200 dark:hover:bg-sky-800'}`}>{label}<Icon name="tabler:arrow-up-right" class="w-3 h-3" /></a>
                  ))}
                </div>
                <a {...(poster || paper ? view(poster ? 'poster' : 'paper') : { href: p.paper, target: '_blank', rel: 'noopener' })} class="block text-sm font-medium line-clamp-3 after:absolute after:inset-0">{p.title}</a>
                {p.authors && <p class="text-xs text-muted mt-1 line-clamp-2">{p.authors}</p>}
              </div>
            </li>
            );
          })}
        </ul>
        <div class="mt-8 flex justify-center">
          <input type="checkbox" id="show-all-papers" class="peer sr-only" />
          <label for="show-all-papers" class="btn-primary cursor-pointer peer-focus-visible:ring-2 peer-focus-visible:ring-offset-2">
            <span class="group-has-[:checked]:hidden">Show all {acceptedPapers.length} papers</span>
            <span class="hidden group-has-[:checked]:inline">Show fewer</span>
          </label>
        </div>
        <p class="mt-4 text-center text-sm text-muted">
          Papers, posters, and videos are archived on
          <a href="https://github.com/REO-workshop/2025-EurIPS-REO-workshop" target="_blank" rel="noopener" class="text-primary underline">GitHub</a>.
        </p>
      </div>
      <PdfViewer />
    </div>
  </section>

  <!-- Sponsors -->
  <section id="sponsors" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter">Sponsors</h2>
      </div>

      <div class="flex justify-center">
        <a href="https://research.ibm.com/" target="_blank" rel="noopener noreferrer" class="flex w-full max-w-md items-center justify-center rounded-lg border border-blue-200 bg-white p-8 dark:border-blue-300 dark:bg-white">
          <img src={ibmResearchLogo.src} alt="IBM Research" class="h-12 w-auto" />
        </a>
      </div>
    </div>
  </section>

  <!-- Organizers -->
  <section id="organizers" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Organizers</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {organizers2025.map((o) => (
          <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
            <p class="font-semibold">{o.name}</p>
            <p class="text-sm text-muted mt-1">{o.affiliation}</p>
          </div>
        ))}
      </div>

      <div class="mt-10">
        <details class="group rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
          <summary class="cursor-pointer font-semibold flex items-center justify-between">
            <span>Program Committee</span>
            <span class="text-sm text-muted group-open:hidden">Show</span>
            <span class="text-sm text-muted hidden group-open:inline">Hide</span>
          </summary>
          <p class="text-sm text-muted mt-4">
            Thanks to the Program Committee for reviewing submissions to REO-1.
          </p>
          <ul class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-1 text-sm text-muted">
            {programCommittee2025.map((pc) => <li>· <span class="text-gray-900 dark:text-gray-100 font-medium">{pc}</span></li>)}
          </ul>
        </details>
      </div>
      <p class="text-sm text-muted mt-10">
        The Microsoft CMT service was used for managing the peer-reviewing process for this conference. This service was provided for free by Microsoft and they bore all expenses, including costs for Azure cloud services as well as for software development and support.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h3 class="text-2xl font-bold mb-2">Contact</h3>
      <p class="text-muted">
        For questions about the workshop, reach out to
        <a href="mailto:reo-workshop@googlegroups.com" class="text-primary underline">reo-workshop@googlegroups.com</a>.
      </p>
      <p class="text-muted">
        General inquiries: <a href="mailto:contact@eurips.cc" class="text-primary underline">contact@eurips.cc</a>
      </p>
    </div>
  </section>

  <!-- CTA back to REO-2 -->
  <section class="py-12 md:py-16 bg-blue-50 dark:bg-transparent">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl md:text-3xl font-bold leading-tight tracking-tighter mb-4">
        Continuing at NeurIPS 2026
      </h2>
      <p class="text-lg text-muted mb-6">
        The second edition takes place in Paris, France · Saturday, Dec 12, 2026.
      </p>
      <a href="/" class="btn-primary py-3 px-8 font-semibold">Visit REO 2026 →</a>
    </div>
  </section>
</Layout>
