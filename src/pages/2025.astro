---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import Hero from '~/components/widgets/Hero.astro';
import { Icon } from 'astro-icon/components';
import PdfViewer from '~/components/PdfViewer.astro';

import kazmierskiImg from '~/assets/images/speakers2025/kazmierski.jpg';
import campsImg from '~/assets/images/speakers2025/camps.png';
import gottfriedsenImg from '~/assets/images/speakers2025/gottfriedsen.png';
import lesauxImg from '~/assets/images/speakers2025/lesaux.png';
import kariryaaImg from '~/assets/images/speakers2025/kariryaa.png';
import ibmResearchLogo from '~/assets/images/logos/ibm_research.png';
import copenhagenS2 from '~/assets/images/copenhagen_s2.jpg';

const speakers2025 = [
  { name: 'Michal Kazmierski', affiliation: 'Google DeepMind', image: kazmierskiImg },
  { name: 'Gustau Camps-Valls', affiliation: 'Universitat de València', image: campsImg },
  { name: 'Julia Gottfriedsen', affiliation: 'OroraTech', image: gottfriedsenImg },
  { name: 'Bertrand Le Saux', affiliation: 'European Commission', image: lesauxImg },
  { name: 'Ankit Kariryaa', affiliation: 'University of Copenhagen', image: kariryaaImg },
];

const organizers2025 = [
  { name: 'Loïc Landrieu', affiliation: 'ENPC' },
  { name: 'Begüm Demir', affiliation: 'BIFOLD, TU Berlin' },
  { name: 'Nico Lang', affiliation: 'University of Copenhagen' },
  { name: 'Johannes Jakubik', affiliation: 'IBM' },
  { name: 'Valerio Marsocci', affiliation: 'ESA Φ-lab' },
  { name: 'Ruben Cartuyvels', affiliation: 'ESA Φ-lab' },
  { name: 'Hui Zhang', affiliation: 'University of Copenhagen' },
];

const programCommittee2025 = [
  'Benedikt Blumenstiel',
  'Dimitri Gominski',
  'Dino Ienco',
  'Gencer Sumbul',
  'Ghjulia Sialelli',
  'Guillaume Astruc',
  'Hui Zhang',
  'Jan Dirk Wegner',
  'Johannes Jakubik',
  'Linus Scheibenreif',
  'Loïc Landrieu',
  'Lukas Drees',
  'Marc Rußwurm',
  'Mikolaj Czerkawski',
  'Nico Lang',
  'Nicolas Longépé',
  'Peter Naylor',
  'Riccardo D\'Ercole',
  'Ruben Cartuyvels',
  'Sander Jyhne',
  'Steffen Knoblauch',
