const GH_BASE = 'https://github.com/REO-workshop/2025-EurIPS-REO-workshop/blob/main';
// GitHub PDFs are shown in the PdfViewer, served by the repo's GitHub Pages site under this domain.
// Local dev: symlink public/2025-EurIPS-REO-workshop -> the local clone (ignored via .git/info/exclude).
const local = (url?: string) => (url?.startsWith(GH_BASE) ? url.replace(GH_BASE, '/2025-EurIPS-REO-workshop') : undefined);

const acceptedPapers = [
