    authors: 'Fogel et al. (CVPR 2025)',
    paper: 'https://openaccess.thecvf.com/content/CVPR2025/html/Fogel_Open-Canopy_Towards_Very_High_Resolution_Forest_Monitoring_CVPR_2025_paper.html',
  },
  {
    id: 33,
    title: 'Fused Foundation Model Embeddings for Earth Observation Compression: A Winning Solution to the Embed2Scale Challenge',
