---

<Layout metadata={metadata}>
  <Hero
    tagline='<span class="text-blue-300 dark:text-blue-300">NeurIPS 2026 · Paris, France · Saturday, Dec 12</span>'
    actions={[
      { variant: 'primary', text: 'Accepted Papers', href: '#papers' },
      {
        variant: 'secondary',
        text: 'Speakers',
        href: '#speakers',
        class: '!bg-slate-200 hover:!bg-slate-300 !text-slate-900 !border-slate-200 hover:!border-slate-300 dark:!bg-slate-200 dark:hover:!bg-slate-300 dark:!text-slate-900 dark:!border-slate-200',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute -top-[76px] left-0 right-0 bottom-0 overflow-hidden">
        <Image
          src={parisS2}
          alt="Sentinel-2 satellite image of Paris"
          width={2400}
          height={1200}
          widths={[800, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          layout="cover"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-900/75 via-slate-900/60 to-slate-900/85 dark:from-slate-950/85 dark:via-slate-950/70 dark:to-slate-950/90"></div>
      </div>
      <p class="absolute bottom-2 right-3 text-[10px] text-white/70 z-10">
        Sentinel-2 image of Paris – Credit: ESA, European Union
      </p>
    </Fragment>

    <Fragment slot="title">
      <span class="text-white drop-shadow-lg">2nd Workshop on Advances in <span class="text-blue-300">Representation Learning for Earth Observation</span></span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-slate-100">
        Bringing together machine learning, computer vision, and Earth sciences to advance
        robust, interpretable, and scalable models for monitoring and predicting our planet.
      </span>
    </Fragment>
  </Hero>

  <!-- About -->
  <section id="about" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">About REO</p>
      <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2 mb-6">
        A forum for representation learning in Earth Observation
      </h2>
      <div class="space-y-4 text-lg text-muted">
        <p>
          The second edition of the Representation Learning for Earth Observation (REO)
          workshop brings together researchers and practitioners from machine learning,
          computer vision, and Earth sciences. With the growing availability of large-scale,
          multimodal EO data and the rise of powerful foundation models, new opportunities
          emerge for integrating data-driven approaches across sensing
          modalities and application domains.
        </p>
        <p>
          REO provides a venue for novel technical methods, scientific applications,
          and system-level innovations — fostering exchange between academia and industry,
          and policy stakeholders.
        </p>
      </div>
    </div>
  </section>

  <!-- Call for Papers -->
  <section id="call-for-papers" class="scroll-mt-16">
    <Features
      tagline="Call for Papers"
      title="Topics of Interest"
      subtitle="We invite contributions spanning technical methods, scientific applications, and system-level innovations across EO, environmental monitoring, and related Earth sciences."
      columns={3}
      items={[
        {
          title: 'Machine Learning for EO',
          description:
            'Domain-adaptive models; continual and online learning; multi-modal fusion; human-in-the-loop and active learning strategies.',
          icon: 'tabler:brain',
        },
        {
          title: 'EO Foundation Models',
          description:
            'Training paradigms, evaluation and interpretability, uncertainty quantification, and causal modeling for EO foundation models.',
          icon: 'tabler:cube',
        },
        {
          title: 'Earth Embeddings',
          description:
            'Encodings for efficient storage, retrieval, and search in large EO archives; semantic compression for scalable analysis.',
          icon: 'tabler:database',
        },
        {
          title: 'Physics-based & Hybrid Modeling',
          description:
            'Integration of Radiative Transfer Models and other physical simulators into ML pipelines; hybrid AI–physics parameter retrieval.',
          icon: 'tabler:atom',
        },
        {
          title: 'Earth Science & Ecology Applications',
          description:
            'Geophysical parameter estimation, urban and rural mapping, weather/climate forecasting, biodiversity, soil and vegetation.',
          icon: 'tabler:plant',
        },
        {
          title: 'Data, Benchmarks & Accessibility',
          description:
            'Multimodal data handling, cross-sensor harmonization, representative datasets, bias mitigation, open benchmarks.',
          icon: 'tabler:chart-dots',
        },
      ]}
    />

    <!-- Tracks + dates -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
      <div class="grid md:grid-cols-2 gap-6">
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-6 bg-white dark:bg-slate-900">
          <h3 class="text-xl font-bold mb-2">Research Track</h3>
          <p class="text-muted">
            Non-archival short papers of up to <strong>4 pages</strong> presenting novel research,
            preliminary results, new datasets, benchmarks, or emerging ideas.
            <strong>Double-blind</strong> peer review. No formal proceedings.
          </p>
        </div>
        <div class="rounded-lg border border-slate-200 dark:border-slate-700 p-6 bg-white dark:bg-slate-900">
          <h3 class="text-xl font-bold mb-2">Highlights Track</h3>
          <p class="text-muted">
            Papers published after NeurIPS 2025 at major ML/CV venues, relevant to EO and
            geospatial AI. Submit the published paper with a short summary (max one page)
            explaining its relevance. <strong>Single-blind</strong> review.
          </p>
        </div>
      </div>

      <div class="mt-6 rounded-lg border border-slate-200 dark:border-slate-700 p-6 bg-white dark:bg-slate-900">
        <details class="group">
          <summary class="cursor-pointer flex items-center justify-between">
            <h3 class="text-xl font-bold">Submission Details</h3>
            <span class="text-sm text-muted group-open:hidden">Show</span>
            <span class="text-sm text-muted hidden group-open:inline">Hide</span>
          </summary>

          <h4 class="font-semibold mt-6 mb-2">Formatting</h4>
          <p class="text-muted">
            Submissions must follow the
            <a href="https://neurips.cc/Conferences/2026/CallForPapers" class="text-primary underline">NeurIPS formatting guidelines</a>,
            with the exception of the page limit: up to <strong>4 pages</strong> for the Research Track
            and up to <strong>1 page</strong> for the Highlights Track summary (references and appendices
            excluded). The checklist is not required for any track. Please use the official
            <a href="https://www.overleaf.com/latex/templates/formatting-instructions-for-neurips-2026/bjdwqfdkyftc" class="text-primary underline">NeurIPS LaTeX template</a>.
            Submissions not following the official template risk a desk rejection.
          </p>
          <p class="text-muted mt-4">
            When using the template, please adjust the following:
          </p>
          <ul class="text-muted mt-2 space-y-2 list-disc pl-5">
            <li>
              Set the workshop title:<br />
              <code class="text-sm">{'\\workshoptitle{2nd Workshop on Advances in Representation Learning for Earth Observation}'}</code>
            </li>
            <li>
              For a Research Track submission (novel work), uncomment the double-blind reviewing option ("6. Workshop with double-blind reviewing"):<br />
              <code class="text-sm">{'\\usepackage[dblblindworkshop]{neurips_2026}'}</code>
            </li>
            <li>
              For a Highlights Track submission (published work), uncomment the single-blind reviewing option ("5. Workshop with single-blind reviewing"):<br />
              <code class="text-sm">{'\\usepackage[sglblindworkshop]{neurips_2026}'}</code>
            </li>
            <li>
              For the camera-ready paper, uncomment the final option, e.g.<br/>
              <code class="text-sm">{'\\usepackage[dblblindworkshop, final]{neurips_2026}'}</code>
            </li>
            <li>
              Remove the checklist for any submission:<br />              
              <s><code class="text-sm">{'\\newpage'}</code></s><br />
              <s><code class="text-sm">{'\\input{checklist.tex}'}</code></s>
            </li>
          </ul>

          <h4 class="font-semibold mt-6 mb-2">Anonymity</h4>
          <p class="text-muted">
            Research Track submissions are reviewed <strong>double-blind</strong>: remove author
            names, affiliations, acknowledgements, and any identifying links or metadata from the
            PDF. Non-anonymized submissions risk a desk rejection. Highlights Track submissions
            are reviewed <strong>single-blind</strong> and need not be anonymized.
          </p>

          <h4 class="font-semibold mt-6 mb-2">Dual Submissions</h4>
          <p class="text-muted">
            REO-2 is non-archival, so concurrent submission to archival venues is permitted from our side, in
            line with the
            <a href="https://neurips.cc/Conferences/2026/MainTrackHandbook" class="text-primary underline">NeurIPS 2026 dual submission policy</a>.
            Please do not submit the same work to multiple NeurIPS 2026 workshops.
            Upon request, we do not publish accepted papers online if this would
            hinder a submission to an archival venue.
          </p>

          <h4 class="font-semibold mt-6 mb-2">Use of LLMs</h4>
          <p class="text-muted">
            We follow the
            <a href="https://neurips.cc/Conferences/2026/MainTrackHandbook" class="text-primary underline">NeurIPS 2026 LLM policy</a>.
            Disclose LLM or agent use where it is an important, original, or non-standard component
            of the approach; routine editing and basic code assistance need not be disclosed. LLMs
            cannot be authors, and authors remain fully responsible for the correctness and
            originality of their submission, including all citations.
          </p>

          <h4 class="font-semibold mt-6 mb-2">Registration &amp; Code of Conduct</h4>
          <p class="text-muted">
            Presentation is in person, so at least one author of each accepted paper needs to attend the workshop in Paris. 
            All participants are bound by the
            <a href="https://neurips.cc/public/CodeOfConduct" class="text-primary underline">NeurIPS Code of Conduct</a>.
          </p>
        </details>
      </div>


      <div class="mt-10 flex justify-center">
        <p class="rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 py-3 px-8 font-semibold text-base text-muted">
          Submissions are closed
        </p>
      </div>

      <div class="mt-10">
        <h3 class="text-2xl font-bold mb-4">Important Dates</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-slate-200 dark:border-slate-700">
                <th class="py-3 pr-4 font-semibold">Milestone</th>
                <th class="py-3 font-semibold">Date (AoE)</th>
              </tr>
            </thead>
            <tbody class="text-muted">
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-3 pr-4">Submission portal opens</td><td class="py-3">Aug 1, 2026</td>
              </tr>
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-3 pr-4">Submission deadline</td><td class="py-3">Sep 2, 2026</td>
              </tr>
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-3 pr-4">Notification</td><td class="py-3">Sep 29, 2026</td>
              </tr>
              <tr class="border-b border-slate-100 dark:border-slate-800">
                <td class="py-3 pr-4">Camera-ready</td><td class="py-3">Oct 14, 2026</td>
              </tr>
              <tr>
                <td class="py-3 pr-4">Workshop day</td><td class="py-3">Dec 12, 2026 — Palais des Congrès (Room 351), Paris</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-sm text-muted mt-4">
          In-person presentation is expected. The best papers will be selected for oral presentations.
        </p>
      </div>
    </div>
  </section>

  <!-- Speakers — 3 on top row, 2 centered on second row -->
  <section id="speakers" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">Invited Speakers</p>
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Keynotes</h2>
        <p class="max-w-3xl mx-auto mt-4 text-xl text-muted">
          Five speakers representing the diversity of the EO community — spanning academia, industry, ML, and Earth sciences.
        </p>
      </div>

      <!-- Speakers: centered, auto-wrapping (3 / 2 / 1 per row by breakpoint) -->
      <div class="flex flex-wrap justify-center gap-6">
        {speakers.map((s) => (
          <div class="flex flex-col rounded-lg overflow-hidden border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md transition-shadow w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
            <div class="aspect-square overflow-hidden bg-slate-100 dark:bg-slate-800">
              <Image
                src={s.image}
                alt={s.name}
                width={600}
                height={600}
                layout="constrained"
                widths={[300, 600, 900]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                class="w-full h-full object-cover object-center"
              />
            </div>
            <div class="p-5">
              <h3 class="text-lg font-bold">{s.name}</h3>
              <p class="text-sm text-primary dark:text-blue-300 font-medium mb-2">{s.affiliation}</p>
              <p class="text-sm text-muted">{s.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Schedule -->
  <section id="schedule" class="scroll-mt-16 py-16 md:py-20 bg-blue-50 dark:bg-transparent">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">Program</p>
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Provisional Schedule<span class="text-secondary dark:text-blue-200">*</span></h2>
        <p class="max-w-3xl mx-auto mt-4 text-xl text-muted">
          Keynotes, orals, two poster sessions, and a panel – 100% of talks in person.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-xl font-bold mb-4">Morning</h3>
          <ul class="space-y-3">
            {scheduleMorning.map((item) => (
              <li class="flex items-start gap-4 rounded-md bg-white dark:bg-slate-900 p-4 border border-slate-200 dark:border-slate-700">
                <span class="font-mono text-sm text-primary dark:text-blue-300 whitespace-nowrap pt-0.5">{item.time}</span>
                <span class="text-base">{item.title}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-4">Afternoon</h3>
          <ul class="space-y-3">
            {scheduleAfternoon.map((item) => (
              <li class="flex items-start gap-4 rounded-md bg-white dark:bg-slate-900 p-4 border border-slate-200 dark:border-slate-700">
                <span class="font-mono text-sm text-primary dark:text-blue-300 whitespace-nowrap pt-0.5">{item.time}</span>
                <span class="text-base">{item.title}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      
      <div class="mb-10 md:mb-12 text-center">
        <p class="max-w-3xl mx-auto mt-3 text-sm text-muted">
          *The program is still being finalized and may change – please check back closer to the workshop day.
        </p>
      </div>
    </div>
  </section>

  <!-- Accepted Papers -->
  <section id="papers" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <p class="text-base text-secondary dark:text-blue-200 font-semibold tracking-wide uppercase">Program</p>
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Accepted Papers</h2>
        <p class="max-w-3xl mx-auto mt-4 text-xl text-muted">
          {acceptedPapers.length} papers will be presented at REO-2. Browse all papers on the
          <a href={neuripsWorkshopUrl} target="_blank" rel="noopener" class="text-primary underline">NeurIPS workshop page</a>.
        </p>
      </div>

      <!-- First 9 shown; the checkbox reveals the rest (CSS only) -->
      <div class="group">
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {acceptedPapers.map((p, i) => (
            <li class={i >= 9 ? 'hidden group-has-[:checked]:block' : ''}>
              <a
                href={`https://neurips.cc/virtual/2026/${p.id}`}
                target="_blank"
                rel="noopener"
                class="block h-full rounded-md bg-white dark:bg-slate-900 p-4 border border-slate-200 dark:border-slate-700 hover:border-primary dark:hover:border-blue-300 transition-colors"
              >
                <p class="text-sm font-medium line-clamp-3">{p.title}</p>
                <p class="text-xs text-muted mt-1 line-clamp-2">{p.authors}</p>
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-8 flex justify-center">
          <input type="checkbox" id="show-all-papers" class="peer sr-only" />
          <label for="show-all-papers" class="btn-primary cursor-pointer peer-focus-visible:ring-2 peer-focus-visible:ring-offset-2">
            <span class="group-has-[:checked]:hidden">Show all {acceptedPapers.length} papers</span>
            <span class="hidden group-has-[:checked]:inline">Show fewer</span>
          </label>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsors -->
  <section id="sponsors" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter">Sponsors</h2>
      </div>

      <div class="grid max-w-4xl mx-auto gap-8 sm:grid-cols-2">
        <a
          href="https://hi-paris.fr/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full max-w-md items-center justify-center rounded-lg border border-blue-200 bg-white p-6 dark:border-blue-300 dark:bg-white"
        >
          <Image
            src={hiParisLogo}
            alt="Hi! PARIS, HEC Paris, and Institut Polytechnique de Paris"
            width={800}
            height={400}
            widths={[400, 800]}
            sizes="(max-width: 448px) calc(100vw - 80px), 400px"
            class="w-full h-auto"
          />
        </a>
        <a
          href="https://thinking-earth.eu/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full max-w-md items-center justify-center overflow-hidden rounded-lg border border-blue-200 bg-white p-6 dark:border-blue-300 dark:bg-white"
        >
          <Image
            src={thinkingEarthLogo}
            alt="ThinkingEarth"
            widths={[400, 800]}
            sizes="(max-width: 640px) calc(100vw - 80px), 400px"
            class="w-full h-auto"
          />
        </a>
        <a
          href="https://www.esa.int/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full max-w-md items-center justify-center rounded-lg bg-slate-900 p-6"
        >
          <Image
            src={esaLogo}
            alt="European Space Agency"
            widths={[400, 800]}
            sizes="(max-width: 640px) calc(100vw - 80px), 400px"
            class="w-full h-auto"
          />
        </a>
        <a
          href="https://swissgeolab.ethz.ch/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full max-w-md items-center justify-center overflow-hidden rounded-lg bg-slate-900 p-4"
        >
          <Image
            src={swissGeoLabLogo}
            alt="Swiss GeoLab"
            widths={[400, 800]}
            sizes="(max-width: 640px) calc(100vw - 80px), 400px"
            class="w-full h-auto"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- Organizers -->
  <section id="organizers" class="scroll-mt-16 py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="mb-10 md:mb-12 text-center">
        <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tighter mt-2">Organizers</h2>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {organizers.map((o) => (
          <div class="rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
            <p class="font-semibold">{o.name}</p>
            <p class="text-sm text-muted mt-1">{o.affiliation}</p>
          </div>
        ))}
      </div>

      <div class="mt-10">
        <details class="group rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5">
          <summary class="cursor-pointer font-semibold flex items-center justify-between">
            <span>Program Committee</span>
            <span class="text-sm text-muted group-open:hidden">Show</span>
            <span class="text-sm text-muted hidden group-open:inline">Hide</span>
          </summary>
          <p class="text-sm text-muted mt-4">
            Thank you to our reviewers for their time and expertise in reviewing submissions to REO-2.
          </p>
          <ul class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-1 text-sm text-muted">
            {programCommittee.map((pc) => <li>· <span class="text-gray-900 dark:text-gray-100 font-medium">{pc}</span></li>)}
          </ul>
        </details>
      </div>

      <!-- Contact -->
      <div class="mt-12 text-center">
        <h3 class="text-2xl font-bold mb-2">Contact</h3>
        <p class="text-muted">
          For questions about the workshop, reach out to
          <a href="mailto:reo-workshop@googlegroups.com" class="text-primary underline">reo-workshop@googlegroups.com</a>.
        </p>
      </div>
      <br>
      <p class="text-sm text-muted">
        The Microsoft CMT service was used for managing the peer-reviewing process for this conference. This service was provided for free by Microsoft and they bore all expenses, including costs for Azure cloud services as well as for software development and support.          
      </p>
    </div>
  </section>
</Layout>
